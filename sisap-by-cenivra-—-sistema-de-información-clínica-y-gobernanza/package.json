{
  "name": "sisap-by-cenivra",
  "productName": "SISAP by CENIVRA",
  "private": true,
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.0.0"
  },
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "backend": "node backend/src/server.js",
    "test": "node --test backend/test/*.test.js",
    "test:backend": "node --test backend/test/*.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist',{recursive:true,force:true}); if(fs.existsSync('server.js')) fs.unlinkSync('server.js');\"",
    "lint": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "electron:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-packager . \"SISAP_by_CENIVRA\" --platform=win32 --arch=x64 --out=dist-desktop --icon=assets/icons/sisap.ico --overwrite --asar=false --prune=true",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "org.cenivra.sisap",
    "productName": "SISAP by CENIVRA",
    "copyright": "Copyright © 2026 CENIVRA",
    "directories": {
      "output": "dist-electron"
    },
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/sisap.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SISAP by CENIVRA",
      "uninstallDisplayName": "SISAP by CENIVRA"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/**/*"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
